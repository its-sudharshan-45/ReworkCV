NODE_ENV=development
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESUME_STORAGE_BUCKET=resumes
RESUME_MAX_FILE_SIZE_BYTES=5242880

GROQ_API_KEY=your_groq_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key

AI_PRIMARY_PROVIDER=local
AI_FALLBACK_ENABLED=true
AI_FALLBACK_PROVIDERS=groq,anthropic,openai
AI_TIMEOUT_MS=30000
AI_FALLBACK_BUDGET_MS=60000

# Local-first LLM (Ollama-compatible). No cloud API key required.
LOCAL_AI_ENABLED=true
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_MODEL=llama3.1:8b
LOCAL_AI_TIMEOUT_MS=30000

# Optional per-provider timeout caps (each falls back to AI_TIMEOUT_MS)
# GROQ_TIMEOUT_MS=20000
# ANTHROPIC_TIMEOUT_MS=20000
# OPENAI_TIMEOUT_MS=20000

HF_CACHE_DIR=.cache/huggingface

RAG_ENABLED=true
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.10
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=384
RAG_MAX_CONTEXT_CHARS=6000
RAG_CACHE_TTL_MS=300000
RAG_TIMEOUT_MS=15000
# Admin-only key for RAG ingestion/reindex endpoints (never expose to frontend).
# Leave empty to disable admin endpoints (fail-closed 403). When set, must be
# at least 32 chars (enforced at startup). Generate with: openssl rand -hex 32
RAG_ADMIN_API_KEY=
# Production: CORS_ORIGIN must be explicit https origins, comma-separated.
# Never use "*" or localhost in production (rejected at startup).
# Example: CORS_ORIGIN=https://app.example.com
