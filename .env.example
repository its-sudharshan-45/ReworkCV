# ==============================================================================
# Rework CV — Environment Configuration Template
# Copy this file to .env (or backend/.env and frontend/.env.local) and fill in
# your real credentials. NEVER commit files containing real keys or secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
BACKEND_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
RESUME_STORAGE_BUCKET=resumes
RESUME_MAX_FILE_SIZE_BYTES=5242880
RESUME_UPLOAD_MAX_CONCURRENT=4
RESUME_MAX_EXTRACTED_CHARS=200000

# ------------------------------------------------------------------------------
# Frontend Configuration (React + Vite)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------------------------
# AI Provider Configuration (Multi-provider LLMs)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key

AI_PRIMARY_PROVIDER=local
AI_FALLBACK_ENABLED=true
AI_FALLBACK_PROVIDERS=groq,anthropic,openai
AI_TIMEOUT_MS=30000
AI_FALLBACK_BUDGET_MS=60000

# Local-first LLM (Ollama-compatible). No cloud API key required.
LOCAL_AI_ENABLED=true
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_MODEL=llama3.1:8b
LOCAL_AI_TIMEOUT_MS=30000

# Local AI / Hugging Face model cache directory
HF_CACHE_DIR=.cache/huggingface

RAG_ENABLED=true
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.10
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=384
RAG_MAX_CONTEXT_CHARS=6000
RAG_CACHE_TTL_MS=300000
RAG_TIMEOUT_MS=15000
RAG_ADMIN_API_KEY=
